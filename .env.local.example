# Bank Statement Converter API Key
# Get your API key from https://bankstatementconverter.com/
# IMPORTANT: Use server-side only (no NEXT_PUBLIC_ prefix for security)
BANK_STATEMENT_CONVERTER_API_KEY=your_api_key_here

# Passkey Authentication
# Generate hash using: npx ts-node scripts/generate-passkey.ts
# See AUTH_SETUP.md for detailed instructions
NEXT_PUBLIC_PASSKEY_HASH=your_passkey_hash_here
